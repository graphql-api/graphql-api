{
  "name": "graphql-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.6.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@graphql-api/docs",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "peers:check": "pnpm peers check",
    "release:check": "node scripts/release-check.mjs",
    "typecheck": "turbo typecheck",
    "check": "pnpm lint && pnpm format:check && pnpm peers:check && pnpm release:check && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "docs": "pnpm --filter @graphql-api/docs dev",
    "docs:build": "pnpm --filter @graphql-api/docs build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "shadcn": "4.21.0",
    "turbo": "2.10.13",
    "typescript": "7.0.2"
  }
}
